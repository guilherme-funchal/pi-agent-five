# Variáveis usadas pelo Docker Compose durante build/portas.
PI_CODING_AGENT_VERSION=latest
PI_WEB_ACCESS_VERSION=0.14.0
PI_MEMORY_VERSION=0.4.0
AGENT1_HTTP_PORT=8081
AGENT2_HTTP_PORT=8082
AGENT3_HTTP_PORT=8083
AGENT4_HTTP_PORT=8084
AGENT5_HTTP_PORT=8085
# Execução rápida de tarefas agendadas.
# subagent evita que o agendamento espere uma conversa interativa terminar.
SCHEDULE_EXECUTION_MODE=subagent
PI_SCHEDULE_MODEL=local-llama/Qwen3.5-9B-Q4_K_M.gguf
PI_SCHEDULE_EXTENSIONS=pi-web-access,pi-subagents
SCHEDULE_START_NOTIFICATION=true
SCHEDULE_DELAY_WARNING_MS=30000
SCHEDULE_SUBAGENT_OUTPUT_CHARS=12000

# Proteção: schedule_prompt só pode criar tarefas quando houver intenção explícita.
SCHEDULE_INTENT_GUARD=true
SCHEDULE_CRON_GUARD=true
SCHEDULE_AUTH_FILE=/data/schedule-intent-authorization.json
SCHEDULE_AUTH_TTL_MS=900000


# Serviço compartilhado de transcrição whisper.cpp.
WHISPER_CPP_VERSION=v1.9.1
WHISPER_HTTP_PORT=8086
WHISPER_MODEL=small
WHISPER_LANGUAGE=pt
WHISPER_THREADS=8
WHISPER_NO_GPU=true
# Opcional: URL alternativa para o arquivo ggml-<modelo>.bin.
WHISPER_MODEL_URL=

# Serviço compartilhado de síntese de voz Piper.
PIPER_TTS_VERSION=1.6.0
PIPER_HTTP_PORT=8087
PIPER_VOICE=pt_BR-jeff-medium
