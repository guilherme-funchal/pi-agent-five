# Identidade
AGENT_ID=agent5
PI_SESSION_NAME=agent5
TZ=America/Sao_Paulo
LOG_LEVEL=info
HTTP_PORT=8080

# Modelo Pi. Cada agente pode usar modelo/endpoint diferente.
PI_PROVIDER=local-llama
PI_MODEL=Qwen3.5-9B-Q4_K_M.gguf
PI_BASE_URL=http://host.docker.internal:8001/v1
PI_REWRITE_LOOPBACK_TO_HOST=true
PI_API_KEY=local
PI_CONTEXT_WINDOW=32768
PI_MAX_TOKENS=4096
PI_THINKING=off
PI_REQUEST_TIMEOUT_MS=600000

# Supervisão do subprocesso Pi RPC.
PI_RPC_STARTUP_TIMEOUT_MS=60000
PI_RPC_READY_WAIT_TIMEOUT_MS=90000
PI_RPC_PROBE_TIMEOUT_MS=5000
PI_RPC_PROBE_INTERVAL_MS=500
PI_RPC_AUTO_RESTART=true
PI_RPC_RESTART_BASE_MS=1000
PI_RPC_RESTART_MAX_MS=30000
PI_RPC_TASK_RETRIES=2


# Execução rápida de tarefas agendadas.
# subagent evita que o agendamento espere uma conversa interativa terminar.
SCHEDULE_EXECUTION_MODE=subagent
PI_SCHEDULE_MODEL=local-llama/Qwen3.5-9B-Q4_K_M.gguf
PI_SCHEDULE_EXTENSIONS=pi-web-access,pi-subagents
SCHEDULE_START_NOTIFICATION=true
SCHEDULE_DELAY_WARNING_MS=30000
SCHEDULE_SUBAGENT_OUTPUT_CHARS=12000

# Proteção: schedule_prompt só pode criar tarefas quando houver intenção explícita.
SCHEDULE_INTENT_GUARD=true
SCHEDULE_CRON_GUARD=true
SCHEDULE_AUTH_FILE=/data/schedule-intent-authorization.json
SCHEDULE_AUTH_TTL_MS=900000

# Backend de memória. Não use pi-memory e pi-hermes-memory simultaneamente.
PI_MEMORY_BACKEND=pi-memory

# Memória pi-memory. O caminho está dentro do volume exclusivo deste agente.
PI_MEMORY_DIR=/home/pi/.pi/agent/memory
PI_MEMORY_SNAPSHOT=stable
# qmd não é instalado nesta imagem; os recursos básicos funcionam normalmente.
PI_MEMORY_QMD_UPDATE=off

# Telegram exclusivo deste agente.
# IMPORTANTE: não reutilize o mesmo token em dois agentes com long polling.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
# Se vazio, usa TELEGRAM_ALLOWED_CHAT_IDS como fallback.
TELEGRAM_NOTIFY_CHAT_IDS=


# Áudio do Telegram e transcrição compartilhada via whisper.cpp.
TELEGRAM_AUDIO_ENABLED=true
TELEGRAM_AUDIO_SHOW_TRANSCRIPT=true
TELEGRAM_AUDIO_ACCEPT_DOCUMENTS=true
TELEGRAM_AUDIO_MAX_MB=20
TELEGRAM_AUDIO_MAX_DURATION_SECONDS=600
WHISPER_BASE_URL=http://whisper:8080
WHISPER_INFERENCE_PATH=/inference
WHISPER_LANGUAGE=pt
WHISPER_RESPONSE_FORMAT=json
WHISPER_TIMEOUT_MS=300000
WHISPER_KEEP_TEMP_FILES=false


# Síntese de voz (texto -> áudio) compartilhada via Piper.
TELEGRAM_TTS_ENABLED=true
TTS_BASE_URL=http://piper:5000
TTS_SYNTHESIS_PATH=/synthesize
TTS_VOICE=pt_BR-jeff-medium
TTS_TIMEOUT_MS=300000
TTS_MAX_CHARS=5000
# Piper: valores menores falam mais rápido; 1.0 é a velocidade padrão.
TTS_LENGTH_SCALE=1.0
TTS_NOISE_SCALE=0.667
TTS_NOISE_W_SCALE=0.8
TTS_OPUS_BITRATE=32k
# /voz usa texto + áudio por padrão. Use voice para somente áudio.
TTS_VOICE_COMMAND_MODE=both
TTS_SEND_TEXT_WITH_AUDIO=true
TTS_DEFAULT_MODE=text
TTS_RESPONSE_MODE_FILE=/data/response-modes.json
TTS_KEEP_TEMP_FILES=false

# Modo de entrega associado ao ID de cada tarefa agendada.
SCHEDULE_DELIVERY_FILE=/data/schedule-delivery.json

# Discord deste agente. Use bot/token próprio ou canais não sobrepostos.
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
# Obrigatório para receber confirmações/resultados no Discord quando o pedido vier do Telegram.
# Se vazio, usa DISCORD_ALLOWED_CHANNEL_IDS como fallback.
DISCORD_NOTIFY_CHANNEL_IDS=
DISCORD_REQUIRE_MENTION=true

# Limites
MAX_RESPONSE_CHARS=12000
TELEGRAM_CHUNK_SIZE=3900
DISCORD_CHUNK_SIZE=1900

# Pesquisa web em ambiente headless.
PI_WEB_WORKFLOW=none
BRAVE_API_KEY=
TAVILY_API_KEY=
JINA_API_KEY=
SERPER_API_KEY=

# API HTTP deste agente.
API_TOKEN=
